FROM debian:bookworm-slim

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        netcat-openbsd \
        wine \
        wine32:i386 \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 miracle \
    && install -d -o miracle -g miracle /wine

COPY game-entrypoint.sh /usr/local/bin/game-entrypoint
RUN chmod 0755 /usr/local/bin/game-entrypoint

ENV WINEARCH=win32 \
    WINEPREFIX=/wine \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES=mscoree,mshtml=

USER miracle
WORKDIR /runtime
ENTRYPOINT ["/usr/local/bin/game-entrypoint"]
