FROM rust:1.97.1-bookworm AS builder

WORKDIR /source
COPY server/rust/Cargo.toml server/rust/Cargo.lock server/rust/rust-toolchain.toml ./
COPY server/rust/src ./src
RUN --mount=type=cache,id=nebokrai-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=nebokrai-rust-target,target=/source/target \
    cargo build --release --bins \
    && install -d /artifacts \
    && install /source/target/release/authserver /artifacts/authserver \
    && install /source/target/release/billingserver /artifacts/billingserver \
    && install /source/target/release/loginserver /artifacts/loginserver \
    && install /source/target/release/miscserver /artifacts/miscserver \
    && install /source/target/release/worldserver /artifacts/worldserver

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /artifacts/authserver /opt/miracle/authserver
COPY --from=builder /artifacts/billingserver /opt/miracle/billingserver
COPY --from=builder /artifacts/loginserver /opt/miracle/loginserver
COPY --from=builder /artifacts/miscserver /opt/miracle/miscserver
COPY --from=builder /artifacts/worldserver /opt/miracle/worldserver

WORKDIR /runtime
